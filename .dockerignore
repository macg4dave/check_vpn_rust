# Ignore build artifacts, caches, and other large files that should not
# be included in the Docker build context. When Docker's build context 
# becomes very large (eg. >20GB) BuildKit or the daemon can fail.

# Rust build artifacts
target/

# Git metadata
.git

# CI and GitHub actions
.github/

# Editor / IDE caches
.idea/
.vscode/

# Node / Python / other local caches
node_modules/
venv/
__pycache__/

# Local OS artifacts
.DS_Store

# local archives / images / large dumps
*.tar.gz
*.zip
*.img

# local distro build/package outputs
dist/
build/

#!/usr/bin/env bash
# contrib/ci — helper to run the full test-suite locally (including long/ignored tests)
#
# This script makes it easy to reproduce the CI / integration-test behavior locally.
# It supports two modes:
#  - local : run the full test suite directly on your host Rust toolchain
#  - docker: build the same Debian-based test image used by CI and run the tests
#
# Usage:
#   ./contrib/ci local        # run tests on your host
#   ./contrib/ci docker       # run tests inside the reproducible Debian container
#   ./contrib/ci docker short # build the container and run only non-ignored tests

set -euo pipefail

mode=${1:-local}
shift || true

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT_DIR"

case "$mode" in
  local)
    echo "Running full test-suite locally (note: this uses your host Rust toolchain)"
    echo "You may want to run with: RUST_TEST_THREADS=1 cargo test --workspace -- --ignored --nocapture"
    RUST_TEST_THREADS=1 cargo test --workspace -- --ignored --nocapture
    ;;

  docker)
    echo "Building reproducible test image (contrib/Dockerfile.debian)"
    docker build -t check_vpn_integration -f contrib/Dockerfile.debian .
    echo "Running full test-suite inside container (single-threaded)"
    docker run --rm --name check_vpn_integration_run check_vpn_integration bash -lc "export RUST_TEST_THREADS=1; cargo test --workspace -- --ignored --nocapture"
    ;;

  docker-short)
    echo "Build container and run typical CI test (non-ignored)"
    docker build -t check_vpn_integration -f contrib/Dockerfile.debian .
    docker run --rm check_vpn_integration cargo test --workspace --verbose
    ;;

  *)
    echo "Unknown mode: $mode"
    echo "Usage: $0 {local|docker|docker-short}"
    exit 2
    ;;
esac

echo "All done."

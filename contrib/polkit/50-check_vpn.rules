/* Optional example. Install manually after setting the allowed unit name.
 * Grants only restart of this exact unit, never arbitrary unit management/reboot.
 * See INSTALL.md. Not installed automatically by packages.
 */
polkit.addRule(function(action, subject) {
    if (subject.user == 'checkvpn' &&
        action.id == 'org.freedesktop.systemd1.manage-units' &&
        action.lookup('unit') == 'openvpn-client@myvpn.service' &&
        action.lookup('verb') == 'restart') {
        return polkit.Result.YES;
    }
    // Leave unrelated requests to the system's normal policy.
});

# Fedora-based packaging image for building RPM reproducibly
# Installs rustup, the stable Rust toolchain, and fpm/rpm build tooling.

FROM fedora:latest AS base

RUN dnf -y update && dnf install -y --setopt=tsflags=nodocs \
    gcc make openssl-devel pkgconfig ca-certificates curl git rpm-build ruby rubygems libcurl-devel \
  && dnf clean all

ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /workdir

# Install rustup & toolchain using BuildKit cache mounts
RUN --mount=type=cache,id=cargo-registry,target=/root/.cargo/registry \
    --mount=type=cache,id=cargo-git,target=/root/.cargo/git \
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable \
  && /root/.cargo/bin/rustc --version

# Builder stage installs fpm (gem) and any build deps
RUN gem install --no-document fpm
RUN rm -rf /root/.cargo/registry/cache /root/.cargo/git /root/.rustup/cache || true

WORKDIR /workdir
CMD ["bash"]

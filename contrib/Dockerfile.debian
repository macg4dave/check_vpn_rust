# syntax=docker/dockerfile:1
FROM rust:1.99.1-slim-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends git pkg-config libssl-dev shellcheck make \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src/check_vpn
COPY Cargo.toml Cargo.lock ./
# Fetch before copying source so code changes reuse the dependency layer.
RUN mkdir -p src && printf 'fn main() {}\n' > src/main.rs && cargo fetch --locked
COPY src ./src
COPY tests ./tests
COPY scripts ./scripts
COPY contrib ./contrib
COPY .githooks ./.githooks
COPY .cargo ./.cargo
COPY examples ./examples
COPY .dockerignore ./
COPY README.md INSTALL.md LICENSE ./
RUN cargo build --release --locked
CMD ["bash", "-c", "bash scripts/check-shell.sh && cargo test --workspace --locked"]

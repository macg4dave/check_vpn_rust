<?xml version="1.0" encoding="utf-8"?>
<!-- Example config file for check_vpn. Place at /etc/check_vpn/config.xml or pass with --config -->
<config>
  <!-- Seconds between checks -->
  <interval>60</interval>

  <!-- ISP string observed when VPN is lost -->
  <isp_to_check>YourISP</isp_to_check>

  <!-- Action: log (default), reboot, restart-unit, command -->
  <vpn_lost_action_type>log</vpn_lost_action_type>

  <!-- For restart-unit put the systemd unit name; for command put the full command -->
  <vpn_lost_action_arg></vpn_lost_action_arg>

  <!-- Connectivity probes -->
  <connectivity_endpoints>8.8.8.8</connectivity_endpoints>
  <connectivity_endpoints>1.1.1.1</connectivity_endpoints>
  <connectivity_ports>443</connectivity_ports>
  <connectivity_ports>53</connectivity_ports>

  <connectivity_timeout_secs>2</connectivity_timeout_secs>
  <connectivity_retries>1</connectivity_retries>

  <!-- Providers: leave defaults enabled or customize -->
  <enable_ip_api>true</enable_ip_api>
  <enable_ifconfig_co>true</enable_ifconfig_co>
  <!-- Optional: custom providers -->
  <!--
  <provider_urls>https://example.com/ipinfo.json</provider_urls>
  -->
</config>

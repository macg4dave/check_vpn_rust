FROM rust:1.99.1-slim-bookworm AS base

RUN apt-get update \
    && apt-get install -y --no-install-recommends git pkg-config libssl-dev dpkg-dev fakeroot \
    && rm -rf /var/lib/apt/lists/*
RUN cargo install --locked cargo-deb
WORKDIR /workdir
# Mount the source at /workdir and invoke contrib/cargo-deb.sh or cargo deb.
CMD ["bash"]

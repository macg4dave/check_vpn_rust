# Debian-based packaging image for building .deb reproducibly
# This image installs rustup, the stable Rust toolchain, and cargo-deb.
# Usage: build with `docker build -t check_vpn_debian_packaging -f contrib/Dockerfile.debian-packaging .`

FROM --platform=$BUILDPLATFORM debian:bookworm-slim AS base

ARG DEBIAN_FRONTEND=noninteractive

# Keep tooling in a builder stage and leverage BuildKit cache mounts for cargo
# so repeated builds are fast and the final image is lightweight.
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    build-essential \
    pkg-config \
    libssl-dev \
    dpkg-dev \
    fakeroot \
  && rm -rf /var/lib/apt/lists/*

ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /workdir

RUN --mount=type=cache,id=cargo-registry,target=/root/.cargo/registry \
    --mount=type=cache,id=cargo-git,target=/root/.cargo/git \
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable \
  && /root/.cargo/bin/rustc --version

# Install cargo-deb into the builder stage with a single layer
RUN --mount=type=cache,id=cargo-registry,target=/root/.cargo/registry \
    /root/.cargo/bin/cargo install --locked cargo-deb || true
# Strip the installed cargo-deb binary to reduce image size and prune caches
RUN strip --strip-all /root/.cargo/bin/cargo-deb || true
RUN rm -rf /root/.cargo/registry/cache /root/.cargo/git /root/.rustup/cache || true

# Final runtime image — keep it small and include only what we need to run the
# packaging helper; cargo-deb requires the toolchain/runtime as we invoke it.
FROM debian:bookworm-slim AS runtime
ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl libssl-dev dpkg-dev fakeroot pkg-config && rm -rf /var/lib/apt/lists/*

ENV PATH="/root/.cargo/bin:${PATH}"

# Copy only the installed toolchain/bin directory into the runtime image, but
# avoid copying registry/git caches (they were pruned above) to keep the image small.
COPY --from=base /root/.cargo /root/.cargo
COPY --from=base /root/.rustup /root/.rustup
# Ensure permissions are sane and remove any leftover caches just in case
RUN rm -rf /root/.cargo/registry/cache /root/.cargo/git /root/.rustup/cache || true

WORKDIR /workdir

# Default command simply prints minimal help — scripts mount the repo and call helpers.
CMD ["/bin/sh", "-c", "echo 'Mount the repository at /workdir and run /workdir/contrib/cargo-deb.sh (or run ./contrib/cargo-deb.sh locally).' && exec /bin/sh"]

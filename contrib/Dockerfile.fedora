# Fedora-based Dockerfile for testing the project
# This image uses Fedora, installs a Rust toolchain via rustup,
# installs system build deps, and runs `cargo test --verbose` by default.

# syntax = docker/dockerfile:1.4

FROM fedora:latest

# Install system dependencies required to build and run the tests
RUN dnf -y update \
    && dnf install -y \
       gcc \
       make \
       openssl-devel \
       pkgconfig \
       ca-certificates \
       curl \
       git \
       libcurl-devel \
    && dnf clean all

# Install rustup (non-interactive) and the stable toolchain
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable \
    && /root/.cargo/bin/rustc --version

ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /usr/src/check_vpn

# Minimal copy pattern — copy manifests first and seed a small dummy src so
# cargo can populate dependency cache layers. This reduces build context and
# speeds repeated builds.
COPY Cargo.toml Cargo.lock ./
RUN --mount=type=cache,id=cargo-registry,target=/root/.cargo/registry \
    --mount=type=cache,id=cargo-git,target=/root/.cargo/git \
    --mount=type=cache,id=target,target=/usr/src/check_vpn/target \
    mkdir -p src && printf 'fn main() { println!("build-cache"); }\n' > src/main.rs \
    && cargo build --release || true

# Copy full project and run tests by default.
COPY src ./src
COPY tests/support ./tests/support
COPY examples ./examples

RUN --mount=type=cache,id=cargo-registry,target=/root/.cargo/registry \
    --mount=type=cache,id=cargo-git,target=/root/.cargo/git \
    --mount=type=cache,id=target,target=/usr/src/check_vpn/target \
    cargo build --release

CMD ["cargo", "test", "--verbose"]

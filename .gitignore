# Rust/Cargo
/target/
**/target/

# If you are building a binary in the repo root
/check_vpn

# Cargo lock: for libraries you may choose to NOT check in Cargo.lock; uncomment if desired
# /Cargo.lock

# Generated by rustfmt
**/*.rs.bk

# Backup/temporary files
*~
*.swp
*.swo

# IDEs and editors
.idea/
.vscode/
/.history/

# macOS
.DS_Store

# Logs
*.log

# system files
Thumbs.db

# Local build artifacts produced by Makefile
/artifacts/

# Packaging outputs
/release/

# Per-arch target directories created by scripts
/target-*/

# Temporary packaging artifacts (root-level)
/*.deb
/*.rpm

# Temporary files produced by packaging builds or helper scripts that
# sometimes appear in the repository root during local runs (safe to ignore):
# - /tmp/, /tmp/tmp.* or tmp.* directories created by scripts or tests
/tmp/
/tmp/*
tmp*
tmp-*
tmp.*
*.tmp
